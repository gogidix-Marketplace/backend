# Application
NODE_ENV=development
PORT=3010
SERVICE_NAME=commission-calculator-service

# CORS
CORS_ORIGIN=*

# MongoDB
MONGODB_URI=mongodb://localhost:27017/commission-calculator

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=commission-calculator-service
KAFKA_CONSUMER_GROUP=commission-calculator-group
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_AUTH_MECHANISM=plain

# Commission Settings
DEFAULT_CURRENCY=USD
COMMISSION_PRECISION=4
TIER_PRECISION=2

# Schedule
ENABLE_SCHEDULER=true
COMMISSION_CALCULATION_CRON=0 0 * * *
COMMISSION_PERIOD_CRON=0 0 1 * *

# Logging
LOG_LEVEL=debug
