# Site Configuration
NEXT_PUBLIC_SITE_URL=https://gogidix.com
NEXT_PUBLIC_API_URL=https://api.gogidix.com

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Site Verification
GOOGLE_SITE_VERIFICATION=your_verification_token

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_COOKIE_CONSENT=true

# Environment
NODE_ENV=development

# Deployment
# VERCEL_URL=your-vercel-url.vercel.app
