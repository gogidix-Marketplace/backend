# Application
NODE_ENV=development
PORT=3007
SERVICE_NAME=lead-scoring-service

# MongoDB
MONGODB_URI=mongodb://localhost:27017/lead_scoring_db
MONGODB_CONNECTION_TIMEOUT=10000
MONGODB_SOCKET_TIMEOUT=45000

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=lead-scoring-service
KAFKA_CONSUMER_GROUP_ID=lead-scoring-consumer-group
KAFKA_LEAD_SCORED_TOPIC=lead.scored
KAFKA_SCORE_MODEL_UPDATED_TOPIC=scoring.model.updated
KAFKA_LEAD_QUALIFIED_TOPIC=lead.qualified

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# JWT
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRATION=3600

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Scoring Configuration
DEFAULT_SCORE_MODEL_ID=default-model
SCORE_DECAY_ENABLED=true
SCORE_DECAY_DAYS=30
SCORE_DECAY_RATE=0.1

# A/B Testing
AB_TESTING_ENABLED=true
