# Application Configuration
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN=*

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/payment-automation
MONGODB_DIRECT_CONNECTION=false

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=payment-automation-service
KAFKA_CONSUMER_GROUP=payment-automation-group
KAFKA_SSL_ENABLED=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Stripe Configuration
STRIPE_API_KEY=sk_test_your_stripe_api_key_here

# TransferWise Configuration
TRANSFERWISE_API_KEY=your_transferwise_api_key_here
TRANSFERWISE_BASE_URL=https://api.transferwise.com
TRANSFERWISE_PROFILE_ID=your_profile_id_here

# Logging
LOG_LEVEL=debug
