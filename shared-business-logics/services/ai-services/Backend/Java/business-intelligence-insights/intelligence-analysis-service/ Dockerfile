# -----------------------------------------------------------------------------
# Multi-stage Dockerfile for AI IntelligenceReport Analysis Service
# -----------------------------------------------------------------------------

FROM maven:3.9.12-eclipse-temurin-17 AS builder

LABEL maintainer="Gogidix AI Services"
LABEL stage="builder"

WORKDIR /build

# Copy pom.xml and download dependencies (cached layer)
COPY pom.xml .
RUN mvn dependency:go-offline -B

# Copy source code
COPY src ./src

# Build application
RUN mvn clean package -DskipTests -Pprod && \
    mv target/*.jar app.jar

# -----------------------------------------------------------------------------
# Runtime stage
# -----------------------------------------------------------------------------
FROM eclipse-temurin:17-jre-alpine

LABEL maintainer="Gogidix AI Services"
LABEL description="AI IntelligenceReport Analysis Service - Production Runtime"

# Create non-root user
RUN addgroup -S spring && adduser -S spring -G spring

# Install dependencies for health checks
RUN apk add --no-cache curl

WORKDIR /app

# Copy JAR from builder
COPY --from=builder /build/app.jar application.jar

# Change ownership
RUN chown -R spring:spring /app

USER spring

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/api/v1/health/liveness || exit 1

# JVM options
ENV JAVA_OPTS="-XX:+UseContainerSupport \
               -XX:MaxRAMPercentage=75.0 \
               -XX:InitialRAMPercentage=50.0 \
               -XX:+UseG1GC \
               -XX:+UnlockExperimentalVMOptions \
               -XX:+UseStringDeduplication \
               -Djava.security.egd=file:/dev/./urandom"

# Run application
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar application.jar"]
