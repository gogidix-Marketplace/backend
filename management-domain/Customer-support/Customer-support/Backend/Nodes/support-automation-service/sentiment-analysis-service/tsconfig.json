{
  "compilerOptions": {
    "module": "commonjs", "declaration": true, "removeComments": true,
    "emitDecoratorMetadata": true, "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true, "target": "ES2022",
    "sourceMap": true, "outDir": "./dist", "baseUrl": "./",
    "incremental": true, "skipLibCheck": true, "strict": true,
    "esModuleInterop": true, "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true, "moduleResolution": "node",
    "noImplicitAny": false,
    "paths": {
      "@domain/*": ["src/domain/*"], "@application/*": ["src/application/*"],
      "@infrastructure/*": ["src/infrastructure/*"], "@interfaces/*": ["src/interfaces/*"],
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": ["src/**/*"], "exclude": ["node_modules", "dist", "test", "**/*spec.ts"]
}
