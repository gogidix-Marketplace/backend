<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.1.5</version>
        <relativePath/>
    </parent>

    <groupId>com.gogidix.aiservices</groupId>
    <artifactId>nlp-processing-service</artifactId>
    <version>1.0.0</version>
    <name>NLP Processing Service</name>
    <description>NLP Processing Service for GOGIDIX Social E-commerce Ecosystem</description>
    <packaging>jar</packaging>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <spring-cloud.version>2022.0.3</spring-cloud.version>
        <lombok.version>1.18.28</lombok.version>
        <mockito.version>5.5.0</mockito.version>
        <jacoco.version>0.8.10</jacoco.version>
        <pitest.version>1.15.2</pitest.version>
        <pitest.junit5.version>1.2.1</pitest.junit5.version>

        <!-- Financial-Grade Testing: Coverage Thresholds -->
        <!-- Line coverage minimum for Financial-Grade Blueprint v1.0 -->
        <fg.coverage.minimum>0.85</fg.coverage.minimum>
        <!-- Branch coverage minimum for Financial-Grade Blueprint v1.0 -->
        <fg.branch.minimum>0.75</fg.branch.minimum>
        <!-- Mutation score minimum for Financial-Grade Blueprint v1.0 -->
        <fg.mutation.minimum>60</fg.mutation.minimum>

        <!-- Memory Configuration for CI/Standard Environments -->
        <!-- Reduced heap size to prevent OOM in memory-constrained environments -->
        <surefire.heap.min>128m</surefire.heap.min>
        <surefire.heap.max>512m</surefire.heap.max>
        <pitest.heap.min>128m</pitest.heap.min>
        <pitest.heap.max>512m</pitest.heap.max>

        <!-- Test Parallelism -->
        <!-- Reduced parallelism to prevent memory pressure -->
        <surefire.parallel.tests>1</surefire.parallel.tests>
        <surefire.parallel.methods>1</surefire.parallel.methods>

        <!-- Test timeout for integration tests (MongoDB connection needs time) -->
        <surefire.timeout>180</surefire.timeout>

        <!-- JVM Arguments - Optimized for memory-constrained environments -->
        <!-- -Xms/-Xmx: Heap size -->
        <!-- -XX:MaxMetaspaceSize: Limit class metadata memory -->
        <!-- -XX:ReservedCodeCacheSize: Limit JIT code cache -->
        <!-- -XX:CompressedClassSpaceSize: Limit compressed class space -->
        <!-- -Xss: Reduce thread stack size -->
        <surefire.jvm.args>-Xms${surefire.heap.min} -Xmx${surefire.heap.max} -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=64m -XX:CompressedClassSpaceSize=64m -Xss256k -Djava.awt.headless=true</surefire.jvm.args>
    </properties>

        
    <dependencies>
        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Micrometer for metrics -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- Foundation Shared Libraries (commented out for independent testing) -->
        <!--
        <dependency>
            <groupId>com.gogidix.shared</groupId>
            <artifactId>shared-security</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.gogidix.shared</groupId>
            <artifactId>shared-model</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.gogidix.shared</groupId>
            <artifactId>shared-exceptions</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.gogidix.shared</groupId>
            <artifactId>shared-validation</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.gogidix.shared</groupId>
            <artifactId>shared-audit</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.gogidix.shared</groupId>
            <artifactId>shared-messaging</artifactId>
            <version>1.0.0</version>
        </dependency>
        -->

        <!-- Testing Dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Foundation Shared Library: Testing (commented out for independent testing) -->
        <!--
        <dependency><groupId>com.gogidix.shared</groupId><artifactId>shared-testing</artifactId><version>1.0.0</version><scope>test</scope></dependency>
        -->
    </dependencies>

    <dependencyManagement>
            
    <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <!-- Financial-Grade: 85% line coverage requirement -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <excludes>
                                        <!-- Exclude main bootstrap package from coverage check -->
                                        <exclude>com.gogidix.aiservices.aidocumentclassificationservice</exclude>
                                    </excludes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${fg.coverage.minimum}</minimum>
                                        </limit>
                                        <!-- Also enforce branch coverage -->
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${fg.branch.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!-- Infrastructure layer specific requirement -->
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>com.gogidix.aiservices.aidocumentclassificationservice.infrastructure.**</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.85</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                            <!-- Build fails if coverage is below threshold -->
                            <haltOnFailure>true</haltOnFailure>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.0.0</version>
                <configuration>
                    <!-- Memory Configuration for Financial-Grade Testing -->
                    <argLine>${surefire.jvm.args} @{argLine} -Dsurefire.timeout=${surefire.timeout}</argLine>
                    <!-- Reduced parallelism for memory-constrained environments -->
                    <parallel>methods</parallel>
                    <threadCount>${surefire.parallel.methods}</threadCount>
                    <perCoreThreadCount>false</perCoreThreadCount>
                    <!-- Use JUnit 5 -->
                    <useSystemClassLoader>false</useSystemClassLoader>
                    <!-- Test class inclusion patterns -->
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                    </includes>
                    <!-- Fork configuration -->
                    <forkCount>1</forkCount>
                    <reuseForks>false</reuseForks>
                </configuration>
            </plugin>
            <!-- PIT Mutation Testing Plugin for Financial-Grade Testing -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest.version}</version>
                    
    <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>${pitest.junit5.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <!-- Financial-Grade: 60% mutation threshold -->
                    <mutationThreshold>60</mutationThreshold>
                    <!-- Financial-Grade: 85% line coverage threshold -->
                    <coverageThreshold>85</coverageThreshold>
                    <!-- Timeout per mutation (ms) -->
                    <timeoutConstant>5000</timeoutConstant>
                    <!-- Maximum allowed mutations per class (prevent timeout on large classes) -->
                    <features>+CLASSLIMIT(limit[200])</features>
                    <!-- JVM memory settings for minion process -->
                    <jvmArgs>
                        <jvmArg>-Xms256m</jvmArg>
                        <jvmArg>-Xmx768m</jvmArg>
                        <jvmArg>-XX:+UseG1GC</jvmArg>
                    </jvmArgs>
                    <!-- Mutable code paths -->
                    <targetClasses>
                        <param>com.gogidix.aiservices.aidocumentclassificationservice.domain.**</param>
                        <param>com.gogidix.aiservices.aidocumentclassificationservice.application.**</param>
                        <param>com.gogidix.aiservices.aidocumentclassificationservice.infrastructure.**</param>
                    </targetClasses>
                    <targetTests>
                        <param>com.gogidix.aiservices.aidocumentclassificationservice.**</param>
                    </targetTests>
                    <!-- Exclude test classes and configuration -->
                    <excludedClasses>
                        <param>*.*Test*</param>
                        <param>*.*Config*</param>
                        <param>*.*Application*</param>
                    </excludedClasses>
                    <!-- Generate HTML and XML reports -->
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                    </outputFormats>
                    <!-- Use incremental analysis for faster builds -->
                    <withHistory>true</withHistory>
                    <historyInputFile>${project.build.directory}/pitest-history.bin</historyInputFile>
                    <historyOutputFile>${project.build.directory}/pitest-history.bin</historyOutputFile>
                    <!-- Enable timestamped reports -->
                    <timestampedReports>true</timestampedReports>
                    <!-- Fail build when mutation threshold is not met -->
                    <failWhenNoMutations>false</failWhenNoMutations>
                    <!-- Detect in-progress mutations -->
                    <detectInlinedCode>false</detectInlinedCode>
                </configuration>
                <executions>
                    <!-- PIT Mutation Testing - Disabled due to Windows/JVM compatibility issues -->
                    <!-- To enable: Remove comments and ensure Java 17+ with sufficient heap -->
                    <!-- Run: mvn org.pitest:pitest-maven:mutationCoverage -->
                    <!--
                    <execution>
                        <id>mutation-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>mutationCoverage</goal>
                        </goals>
                    </execution>
                    -->
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Financial-Grade Testing: CI Profiles -->
    <profiles>
        <!-- CI Profile: Coverage-focused for Financial-Grade Blueprint -->
        <!-- PIT disabled temporarily - will be re-enabled after coverage baseline -->
        <!-- Usage: mvn clean verify -Pci -->
        <profile>
            <id>ci</id>
            <properties>
                <!-- Disable PIT mutation testing for now - MINION_DIED issue -->
                <pitest.skip>true</pitest.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.0.0</version>
                        <configuration>
                            <!-- Increase timeout for MongoDB integration tests -->
                            <argLine>${surefire.jvm.args} @{argLine}</argLine>
                            <parallel>methods</parallel>
                            <threadCount>${surefire.parallel.methods}</threadCount>
                            <perCoreThreadCount>false</perCoreThreadCount>
                            <useSystemClassLoader>false</useSystemClassLoader>
                            <includes>
                                <include>**/*Test.java</include>
                                <include>**/*Tests.java</include>
                            </includes>
                            <forkCount>1</forkCount>
                            <reuseForks>false</reuseForks>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Local Development Profile: PIT disabled for faster builds -->
        <!-- Usage: mvn clean verify (default) -->
        <profile>
            <id>local</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <!-- PIT is skipped by default in local builds -->
                <pitest.skip>true</pitest.skip>
            </properties>
        </profile>

        <!-- Certification Profile: Full testing including mutation for Financial-Grade Blueprint -->
        <!-- Usage: mvn clean verify -Pcertification -->
        <profile>
            <id>certification</id>
            <properties>
                <!-- Enable PIT mutation testing for certification -->
                <pitest.skip>false</pitest.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <argLine>${surefire.jvm.args} @{argLine}</argLine>
                            <parallel>methods</parallel>
                            <threadCount>1</threadCount>
                            <perCoreThreadCount>false</perCoreThreadCount>
                            <useSystemClassLoader>false</useSystemClassLoader>
                            <includes>
                                <include>**/*Test.java</include>
                                <include>**/*Tests.java</include>
                            </includes>
                            <forkCount>1</forkCount>
                            <reuseForks>false</reuseForks>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
