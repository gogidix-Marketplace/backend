{
  "name": "ceo-web-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3011",
    "dev:ceo": "vite --port 3011 --open",
    "dev:cfo": "vite --port 3012 --open",
    "dev:coo": "vite --port 3013 --open",
    "dev:cto": "vite --port 3014 --open",
    "dev:all": "concurrently -n CEO,CFO,COO,CTO -c blue,yellow,cyan,purple \"vite --port 3011\" \"vite --port 3012\" \"vite --port 3013\" \"vite --port 3014\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.28.0",
    "@tanstack/react-query-devtools": "^5.96.2",
    "axios": "^1.6.7",
    "class-variance-authority": "^0.7.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.0",
    "recharts": "^2.12.0",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.5.0",
    "yallist": "^5.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^5.1.0",
    "vitest": "^1.4.0"
  }
}
