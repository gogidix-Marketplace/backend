# =============================================================================
# Complete Database Dependencies for MongoDB
# Add to your service's pom.xml <dependencies> section
# =============================================================================

    <!-- ====================================================================
         MongoDB Dependencies
         ==================================================================== -->

    <!-- Spring Data MongoDB -->
    <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-data-mongodb</artifactId>
    </dependency>

    <!-- MongoDB Embedded for Fast Unit Tests -->
    <dependency>
        <groupId>de.flapdoodle.embed</groupId>
        <artifactId>embed-mongo</artifactId>
        <version>4.11.0</version>
        <scope>test</scope>
    </dependency>

    <!-- Mongock for Database Migrations -->
    <dependency>
        <groupId>io.mongock</groupId>
        <artifactId>mongock-springboot</artifactId>
        <version>5.4.0</version>
    </dependency>

    <dependency>
        <groupId>io.mongock</groupId>
        <artifactId>mongodb-springdata-v4-driver</artifactId>
        <version>5.4.0</version>
    </dependency>

    <!-- MongoDB Sync Driver (Required for Mongock 5.x) -->
    <dependency>
        <groupId>org.mongodb</groupId>
        <artifactId>mongodb-driver-sync</artifactId>
    </dependency>

