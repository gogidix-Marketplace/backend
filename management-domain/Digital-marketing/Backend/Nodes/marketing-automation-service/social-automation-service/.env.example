# Server Configuration
NODE_ENV=development
PORT=3002
HOST=0.0.0.0

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/social_automation

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# Twitter Configuration
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# LinkedIn Configuration
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3002/auth/linkedin/callback
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token

# Facebook Configuration
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id

# Instagram Configuration
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_BUS_ACCOUNT_ID=your_instagram_business_account_id

# Queue Configuration
POST_QUEUE_CONCURRENCY=3
POST_QUEUE_MAX_ATTEMPTS=3

# Rate Limiting
API_RATE_LIMIT=100
RATE_LIMIT_WINDOW=60000

# Media Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,video/mp4

# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret_here

# Logging
LOG_LEVEL=info
LOG_FILE=logs/social-automation.log

# API Keys
API_KEY_HEADER=X-API-Key
API_KEYS=api_key_1,api_key_2

# Scheduling
ENABLE_SCHEDULING=true
TIMEZONE=UTC
