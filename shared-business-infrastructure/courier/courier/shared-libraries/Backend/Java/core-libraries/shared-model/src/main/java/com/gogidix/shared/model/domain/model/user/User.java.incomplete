    /**
     * Implementation of abstract validateBusinessRules method.
     */
    @Override
    public ValidationResult validateBusinessRules() {
        List<String> errors = new ArrayList<>();
        
        if (username == null || username.trim().isEmpty()) {
            errors.add("Username is required");
        }
        if (email == null || !email.contains("@")) {
            errors.add("Valid email is required");
        }
        
        return errors.isEmpty() ? 
            ValidationResult.success() :
            ValidationResult.failure(errors);
    }
    
    /**
     * Generate display name from first and last name.
     */
    private String generateDisplayName() {
        if (firstName != null && lastName != null) {
            return firstName + " " + lastName;
        }
        return username != null ? username : "Unknown User";
    }
    
    /**
     * Map user status to entity status.
     */
    private static EntityStatus mapUserStatusToEntityStatus(UserStatus userStatus) {
        return switch (userStatus) {
            case ACTIVE -> EntityStatus.ACTIVE;
            case INACTIVE -> EntityStatus.INACTIVE;
            case SUSPENDED -> EntityStatus.SUSPENDED;
            case BANNED -> EntityStatus.SUSPENDED;
            case PENDING_VERIFICATION -> EntityStatus.PENDING;
            case DELETED -> EntityStatus.DELETED;
        };
    }
}