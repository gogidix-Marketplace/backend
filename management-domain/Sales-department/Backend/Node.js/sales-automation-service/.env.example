# Application
NODE_ENV=development
PORT=3003
SERVICE_NAME=sales-automation-service

# CORS
CORS_ORIGIN=*

# MongoDB
MONGODB_URI=mongodb://localhost:27017/sales-automation

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=sales-automation-service
KAFKA_CONSUMER_GROUP=sales-automation-group

# Topics
KAFKA_TOPIC_AUTOMATION_TRIGGERED=sales.automation.triggered
KAFKA_TOPIC_WORKFLOW_EXECUTED=sales.workflow.executed
KAFKA_TOPIC_WORKFLOW_FAILED=sales.workflow.failed
KAFKA_TOPIC_RULE_CREATED=sales.automation.rule.created
KAFKA_TOPIC_RULE_UPDATED=sales.automation.rule.updated
KAFKA_TOPIC_RULE_DELETED=sales.automation.rule.deleted
KAFKA_TOPIC_LEAD_SCORED=sales.lead.scored
KAFKA_TOPIC_DEAL_STAGE_CHANGED=sales.deal.stage.changed

# Lead Scoring
DEFAULT_LEAD_SCORE_THRESHOLD=50
LEAD_SCORING_ENABLED=true

# Automation
MAX_WORKFLOW_EXECUTION_TIME=300000
MAX_CONCURRENT_WORKFLOWS=10
WORKFLOW_RETRY_ATTEMPTS=3
WORKFLOW_RETRY_DELAY=5000

# Email
EMAIL_SERVICE_ENABLED=true
EMAIL_FROM=noreply@gogidix.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Multi-tenancy
DEFAULT_TENANT_ID=default
ENABLE_MULTI_TENANCY=true
