package com.gogidix.shared.audit.domain.model;

import java.time.LocalDateTime;
import java.time.Duration;
import java.util.Map;
import java.util.Objects;
import java.util.HashMap;

// Enum imports from parent domain package
import com.gogidix.shared.audit.domain.AuditEventType;
import com.gogidix.shared.audit.domain.BusinessDomain;
import com.gogidix.shared.audit.domain.AuditResult;
import com.gogidix.shared.audit.domain.ComplianceType;
import com.gogidix.shared.audit.domain.SecurityLevel;
import com.gogidix.shared.audit.domain.RiskLevel;
import com.gogidix.shared.audit.domain.EventClassification;

/**
 * Rich Domain Model for Audit Event - HEXAGONAL ARCHITECTURE TEMPLATE
 * 
 * This serves as the GOLD STANDARD template for Agent B management services.
 * Demonstrates:
 * - Rich business logic in domain model
 * - Zero infrastructure dependencies  
 * - Immutable design with builder pattern
 * - Comprehensive business validation
 * - Domain-specific business rules
 * 
 * @author Agent A - Foundation Lead
 * @template-for Agent B Management Services
 * @version 1.0.0
 */
public class AuditEvent {
    
    // Core identifiers
    private final String eventId;
    private final String userId;
    private final String sessionId;
    private final String correlationId;
    
    // Event classification
    private final AuditEventType eventType;
    private final BusinessDomain domain;
    private final String action;
    private final AuditResult result;
    
    // Resource information  
    private final String resourceType;
    private final String resourceId;
    private final String resourceName;
    
    // Context information
    private final String ipAddress;
    private final String userAgent;
    private final String location;
    private final LocalDateTime timestamp;
    
    // Compliance and security
    private final ComplianceType complianceType;
    private final SecurityLevel securityLevel;
    private final RiskLevel riskLevel;
    
    // Business data
    private final Map<String, String> additionalData;
    private final String reason;
    private final Double financialAmount;
    private final String currency;
    
    // Constructor for rich domain object creation
    public AuditEvent(String eventId, String userId, AuditEventType eventType, 
                     BusinessDomain domain, String action, AuditResult result) {
        this.eventId = Objects.requireNonNull(eventId, "Event ID cannot be null");
        this.userId = Objects.requireNonNull(userId, "User ID cannot be null");
        this.eventType = Objects.requireNonNull(eventType, "Event type cannot be null");
        this.domain = Objects.requireNonNull(domain, "Business domain cannot be null");
        this.action = Objects.requireNonNull(action, "Action cannot be null");
        this.result = Objects.requireNonNull(result, "Result cannot be null");
        
        // Defaults
        this.timestamp = LocalDateTime.now();
        this.sessionId = null;
        this.correlationId = null;
        this.resourceType = null;
        this.resourceId = null;
        this.resourceName = null;
        this.ipAddress = null;
        this.userAgent = null;
        this.location = null;
        this.complianceType = ComplianceType.STANDARD;
        this.securityLevel = SecurityLevel.NORMAL;
        this.riskLevel = RiskLevel.LOW;
        this.additionalData = new HashMap<>();
        this.reason = null;
        this.financialAmount = null;
        this.currency = null;
    }
    
    // Full constructor for complete objects
    public AuditEvent(String eventId, String userId, String sessionId, String correlationId,
                     AuditEventType eventType, BusinessDomain domain, String action, AuditResult result,
                     String resourceType, String resourceId, String resourceName,
                     String ipAddress, String userAgent, String location, LocalDateTime timestamp,
                     ComplianceType complianceType, SecurityLevel securityLevel, RiskLevel riskLevel,
                     Map<String, String> additionalData, String reason, Double financialAmount, String currency) {
        this.eventId = eventId;
        this.userId = userId;
        this.sessionId = sessionId;
        this.correlationId = correlationId;
        this.eventType = eventType;
        this.domain = domain;
        this.action = action;
        this.result = result;
        this.resourceType = resourceType;
        this.resourceId = resourceId;
        this.resourceName = resourceName;
        this.ipAddress = ipAddress;
        this.userAgent = userAgent;
        this.location = location;
        this.timestamp = timestamp;
        this.complianceType = complianceType;
        this.securityLevel = securityLevel;
        this.riskLevel = riskLevel;
        this.additionalData = additionalData != null ? new HashMap<>(additionalData) : new HashMap<>();
        this.reason = reason;
        this.financialAmount = financialAmount;
        this.currency = currency;
    }
    
    // ==============================================
    // BUSINESS LOGIC METHODS - Template Examples
    // ==============================================
    
    /**
     * Business Rule: Check if event is security-related
     */
    public boolean isSecurityRelated() {
        return eventType.isSecurityEvent() || 
               securityLevel == SecurityLevel.HIGH ||
               securityLevel == SecurityLevel.CRITICAL;
    }
    
    /**
     * Business Rule: Check if event requires compliance tracking
     */
    public boolean requiresCompliance() {
        return complianceType != ComplianceType.NONE ||
               isFinancialTransaction() ||
               isPersonalDataAccess();
    }
    
    /**
     * Business Rule: Check if event is high risk
     */
    public boolean isHighRisk() {
        return riskLevel == RiskLevel.HIGH || 
               riskLevel == RiskLevel.CRITICAL ||
               (isFinancialTransaction() && financialAmount != null && financialAmount > 10000.0);
    }
    
    /**
     * Business Rule: Check if event represents a failed operation
     */
    public boolean isFailed() {
        return result == AuditResult.FAILURE || 
               result == AuditResult.ERROR ||
               result == AuditResult.BLOCKED;
    }
    
    /**
     * Business Rule: Check if event involves financial transactions
     */
    public boolean isFinancialTransaction() {
        return eventType.isFinancialEvent() ||
               financialAmount != null ||
               action.toLowerCase().contains("payment") ||
               action.toLowerCase().contains("transfer");
    }
    
    /**
     * Business Rule: Check if event involves personal data access
     */
    public boolean isPersonalDataAccess() {
        return eventType.isDataAccessEvent() ||
               resourceType != null && resourceType.toLowerCase().contains("personal") ||
               action.toLowerCase().contains("pii");
    }
    
    /**
     * Business Rule: Check if event is from suspicious pattern
     */
    public boolean isSuspicious() {
        return riskLevel == RiskLevel.CRITICAL ||
               (isFailed() && isSecurityRelated()) ||
               hasAnomalousPattern();
    }
    
    /**
     * Business Rule: Check if event requires immediate escalation
     */
    public boolean requiresImmediateEscalation() {
        return isSystemCritical() || 
               (isHighRisk() && isSuspicious()) ||
               (isFinancialTransaction() && financialAmount != null && financialAmount > 100000.0);
    }
    
    /**
     * Business Rule: Check if event is system critical
     */
    public boolean isSystemCritical() {
        return eventType.isSystemCritical() ||
               securityLevel == SecurityLevel.CRITICAL ||
               domain == BusinessDomain.SECURITY;
    }
    
    /**
     * Business Calculation: Get event retention period based on compliance
     */
    public Duration getRetentionPeriod() {
        if (requiresCompliance()) {
            return complianceType.getRetentionPeriod();
        }
        if (isFinancialTransaction()) {
            return Duration.ofDays(2555); // 7 years for financial
        }
        if (isSecurityRelated()) {
            return Duration.ofDays(1095); // 3 years for security
        }
        return Duration.ofDays(365); // 1 year default
    }
    
    /**
     * Business Rule: Check if event has expired based on retention policy
     */
    public boolean hasExpired() {
        Duration retention = getRetentionPeriod();
        return timestamp.plus(retention).isBefore(LocalDateTime.now());
    }
    
    /**
     * Business Calculation: Get event severity score (0-100)
     */
    public int getSeverityScore() {
        int score = 0;
        
        // Base score from risk level
        score += riskLevel.getBaseScore();
        
        // Security events add points
        if (isSecurityRelated()) score += 20;
        
        // Failed events add points  
        if (isFailed()) score += 15;
        
        // Financial transactions add points based on amount
        if (isFinancialTransaction() && financialAmount != null) {
            if (financialAmount > 100000) score += 25;
            else if (financialAmount > 10000) score += 15;
            else if (financialAmount > 1000) score += 10;
        }
        
        // Compliance events add points
        if (requiresCompliance()) score += 10;
        
        // Suspicious patterns add significant points
        if (isSuspicious()) score += 30;
        
        return Math.min(100, score);
    }
    
    /**
     * Business Rule: Check if event should trigger automated response
     */
    public boolean shouldTriggerAutomatedResponse() {
        return getSeverityScore() > 75 ||
               requiresImmediateEscalation() ||
               (isSuspicious() && isSecurityRelated());
    }
    
    /**
     * Business Validation: Validate event data consistency
     */
    public boolean isValidEvent() {
        return eventId != null && !eventId.trim().isEmpty() &&
               userId != null && !userId.trim().isEmpty() &&
               eventType != null &&
               domain != null &&
               action != null && !action.trim().isEmpty() &&
               result != null &&
               timestamp != null &&
               validateFinancialData() &&
               validateSecurityContext();
    }
    
    /**
     * Business Logic: Create enhanced security event
     */
    public AuditEvent withEnhancedSecurity(SecurityLevel newLevel, String reason) {
        return new AuditEvent(
            this.eventId, this.userId, this.sessionId, this.correlationId,
            this.eventType, this.domain, this.action, this.result,
            this.resourceType, this.resourceId, this.resourceName,
            this.ipAddress, this.userAgent, this.location, this.timestamp,
            this.complianceType, newLevel, this.riskLevel,
            this.additionalData, reason, this.financialAmount, this.currency
        );
    }
    
    /**
     * Business Logic: Create compliance-enhanced event
     */
    public AuditEvent withComplianceTracking(ComplianceType complianceType) {
        return new AuditEvent(
            this.eventId, this.userId, this.sessionId, this.correlationId,
            this.eventType, this.domain, this.action, this.result,
            this.resourceType, this.resourceId, this.resourceName,
            this.ipAddress, this.userAgent, this.location, this.timestamp,
            complianceType, this.securityLevel, this.riskLevel,
            this.additionalData, this.reason, this.financialAmount, this.currency
        );
    }
    
    /**
     * Business Logic: Get formatted financial amount
     */
    public String getFormattedFinancialAmount() {
        if (financialAmount == null) return "N/A";
        String currencySymbol = currency != null ? currency : "USD";
        return String.format("%.2f %s", financialAmount, currencySymbol);
    }
    
    /**
     * Business Logic: Get event classification for reporting
     */
    public EventClassification getEventClassification() {
        if (isSystemCritical()) return EventClassification.SYSTEM_CRITICAL;
        if (isHighRisk()) return EventClassification.HIGH_RISK;
        if (isSecurityRelated()) return EventClassification.SECURITY;
        if (isFinancialTransaction()) return EventClassification.FINANCIAL;
        if (requiresCompliance()) return EventClassification.COMPLIANCE;
        return EventClassification.STANDARD;
    }
    
    // Private helper methods for business logic
    private boolean hasAnomalousPattern() {
        // Business logic for anomaly detection
        return additionalData.containsKey("anomaly_detected") ||
               (userAgent != null && userAgent.toLowerCase().contains("bot")) ||
               (ipAddress != null && isKnownMaliciousIp());
    }
    
    private boolean isKnownMaliciousIp() {
        // Business logic for IP reputation checking
        return additionalData.containsKey("malicious_ip") ||
               (ipAddress != null && ipAddress.startsWith("10.0.0"));
    }
    
    private boolean validateFinancialData() {
        if (financialAmount != null) {
            return financialAmount >= 0 && 
                   currency != null && !currency.trim().isEmpty();
        }
        return true;
    }
    
    private boolean validateSecurityContext() {
        if (isSecurityRelated()) {
            return ipAddress != null && !ipAddress.trim().isEmpty() &&
                   sessionId != null && !sessionId.trim().isEmpty();
        }
        return true;
    }
    
    // Additional methods for DTO mapping
    
    /**
     * Calculate severity level based on event characteristics
     */
    public String calculateSeverity() {
        int score = getSeverityScore();
        if (score >= 80) return "CRITICAL";
        if (score >= 60) return "HIGH";
        if (score >= 40) return "MEDIUM";
        if (score >= 20) return "LOW";
        return "INFO";
    }
    
    /**
     * Check if event requires security escalation
     */
    public boolean requiresSecurityEscalation() {
        return requiresImmediateEscalation() || 
               (isSecurityRelated() && securityLevel == SecurityLevel.HIGH);
    }
    
    /**
     * Check if event matches suspicious pattern (alias for isSuspicious)
     */
    public boolean isSuspiciousPattern() {
        return isSuspicious();
    }
    
    /**
     * Check if event is compliant with regulations
     */
    public boolean isCompliantEvent() {
        return requiresCompliance() && result == AuditResult.SUCCESS;
    }
    
    /**
     * Check if event is financial (alias for isFinancialTransaction)
     */
    public boolean isFinancialEvent() {
        return isFinancialTransaction();
    }
    
    // Getters (immutable access)
    public String getEventId() { return eventId; }
    public String getUserId() { return userId; }
    public String getSessionId() { return sessionId; }
    public String getCorrelationId() { return correlationId; }
    public AuditEventType getEventType() { return eventType; }
    public BusinessDomain getDomain() { return domain; }
    public String getAction() { return action; }
    public AuditResult getResult() { return result; }
    public String getResourceType() { return resourceType; }
    public String getResourceId() { return resourceId; }
    public String getResourceName() { return resourceName; }
    public String getIpAddress() { return ipAddress; }
    public String getUserAgent() { return userAgent; }
    public String getLocation() { return location; }
    public LocalDateTime getTimestamp() { return timestamp; }
    public ComplianceType getComplianceType() { return complianceType; }
    public SecurityLevel getSecurityLevel() { return securityLevel; }
    public RiskLevel getRiskLevel() { return riskLevel; }
    public Map<String, String> getAdditionalData() { return new HashMap<>(additionalData); }
    public String getReason() { return reason; }
    public Double getFinancialAmount() { return financialAmount; }
    public String getCurrency() { return currency; }
    
    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (!(o instanceof AuditEvent)) return false;
        AuditEvent that = (AuditEvent) o;
        return Objects.equals(eventId, that.eventId);
    }
    
    @Override
    public int hashCode() {
        return Objects.hash(eventId);
    }
    
    @Override
    public String toString() {
        return String.format("AuditEvent{eventId='%s', userId='%s', eventType=%s, result=%s}", 
                           eventId, userId, eventType, result);
    }
    
    // Static factory methods for common event types
    public static AuditEvent createSecurityEvent(String eventId, String userId, String action, AuditResult result) {
        return new AuditEvent(eventId, userId, AuditEventType.SECURITY_ACCESS, 
                             BusinessDomain.SECURITY, action, result);
    }
    
    public static AuditEvent createFinancialEvent(String eventId, String userId, String action, 
                                                 Double amount, String currency) {
        AuditEvent event = new AuditEvent(eventId, userId, AuditEventType.FINANCIAL_TRANSACTION,
                                         BusinessDomain.FINANCE, action, AuditResult.SUCCESS);
        return new AuditEvent(eventId, userId, event.sessionId, event.correlationId,
                             AuditEventType.FINANCIAL_TRANSACTION, BusinessDomain.FINANCE, action, AuditResult.SUCCESS,
                             event.resourceType, event.resourceId, event.resourceName,
                             event.ipAddress, event.userAgent, event.location, event.timestamp,
                             ComplianceType.FINANCIAL, SecurityLevel.HIGH, RiskLevel.MEDIUM,
                             event.additionalData, event.reason, amount, currency);
    }
    
    // Builder for complex object creation
    public static Builder builder() {
        return new Builder();
    }
    
    public static class Builder {
        private String eventId;
        private String userId;
        private String sessionId;
        private String correlationId;
        private AuditEventType eventType;
        private BusinessDomain domain;
        private String action;
        private AuditResult result;
        private String resourceType;
        private String resourceId;
        private String resourceName;
        private String ipAddress;
        private String userAgent;
        private String location;
        private LocalDateTime timestamp = LocalDateTime.now();
        private ComplianceType complianceType = ComplianceType.STANDARD;
        private SecurityLevel securityLevel = SecurityLevel.NORMAL;
        private RiskLevel riskLevel = RiskLevel.LOW;
        private Map<String, String> additionalData = new HashMap<>();
        private String reason;
        private Double financialAmount;
        private String currency;
        
        public Builder eventId(String eventId) { this.eventId = eventId; return this; }
        public Builder userId(String userId) { this.userId = userId; return this; }
        public Builder sessionId(String sessionId) { this.sessionId = sessionId; return this; }
        public Builder correlationId(String correlationId) { this.correlationId = correlationId; return this; }
        public Builder eventType(AuditEventType eventType) { this.eventType = eventType; return this; }
        public Builder domain(BusinessDomain domain) { this.domain = domain; return this; }
        public Builder action(String action) { this.action = action; return this; }
        public Builder result(AuditResult result) { this.result = result; return this; }
        public Builder resourceType(String resourceType) { this.resourceType = resourceType; return this; }
        public Builder resourceId(String resourceId) { this.resourceId = resourceId; return this; }
        public Builder resourceName(String resourceName) { this.resourceName = resourceName; return this; }
        public Builder ipAddress(String ipAddress) { this.ipAddress = ipAddress; return this; }
        public Builder userAgent(String userAgent) { this.userAgent = userAgent; return this; }
        public Builder location(String location) { this.location = location; return this; }
        public Builder timestamp(LocalDateTime timestamp) { this.timestamp = timestamp; return this; }
        public Builder complianceType(ComplianceType complianceType) { this.complianceType = complianceType; return this; }
        public Builder securityLevel(SecurityLevel securityLevel) { this.securityLevel = securityLevel; return this; }
        public Builder riskLevel(RiskLevel riskLevel) { this.riskLevel = riskLevel; return this; }
        public Builder additionalData(Map<String, String> additionalData) { this.additionalData = additionalData; return this; }
        public Builder reason(String reason) { this.reason = reason; return this; }
        public Builder financialAmount(Double financialAmount) { this.financialAmount = financialAmount; return this; }
        public Builder currency(String currency) { this.currency = currency; return this; }
        
        public AuditEvent build() {
            return new AuditEvent(eventId, userId, sessionId, correlationId, eventType, domain, action, result,
                                resourceType, resourceId, resourceName, ipAddress, userAgent, location, timestamp,
                                complianceType, securityLevel, riskLevel, additionalData, reason, financialAmount, currency);
        }
    }
}