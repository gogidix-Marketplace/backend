# Server Configuration
NODE_ENV=production
PORT=3003
HOST=0.0.0.0

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/log-aggregation-service
MONGODB_DB_NAME=log_aggregation_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=2

# Elasticsearch Configuration
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX_PREFIX=logs-
ELASTICSEARCH_INDEX_TEMPLATE=logs-template

# Log Collection Configuration
LOG_COLLECTION_ENABLED=true
LOG_POLL_INTERVAL=5000
LOG_BATCH_SIZE=100
LOG_FILE_WATCH_ENABLED=true
LOG_WATCH_DIRECTORIES=./logs,/var/log

# Retention Configuration
DEFAULT_RETENTION_DAYS=30
MAX_RETENTION_DAYS=365
CLEANUP_INTERVAL_HOURS=24

# Parsing Configuration
AUTO_PARSE_ENABLED=true
PARSE_JSON_LOGS=true
PARSE_COMMON_FORMATS=true
DETECT_PATTERNS=true

# Real-time Configuration
REALTIME_STREAMING_ENABLED=true
SOCKET_IO_ENABLED=true
SOCKET_IO_PATH=/socket.io

# Notification Configuration
ALERT_WEBHOOK_URL=
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
