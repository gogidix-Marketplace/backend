NODE_ENV=development
PORT=8112
HOST=localhost

MONGODB_URI=mongodb://localhost:27017/gogidix-chatbot
MONGODB_DB_NAME=gogidix-chatbot

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7

KNOWLEDGE_BASE_SERVICE_URL=http://localhost:8115
KNOWLEDGE_BASE_API_KEY=

TICKET_SERVICE_URL=http://localhost:8110
TICKET_API_KEY=

AGENT_SERVICE_URL=http://localhost:8116
AGENT_API_KEY=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

LOG_LEVEL=info
LOG_FILE_PATH=logs

CORS_ORIGIN=http://localhost:3000

SESSION_TIMEOUT_MS=1800000
MAX_CONTEXT_TURNS=20

HANDOFF_THRESHOLD=0.3
MAX_AUTOMATED_TURNS=5
ESCALATION_TOPICS=refund,complaint,legal,sue,fraud

DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,pt,zh,ja,ar

WS_PATH=/socket.io
WS_CORS_ORIGIN=http://localhost:3000

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=chatbot-service
KAFKA_GROUP_ID=chatbot-group
