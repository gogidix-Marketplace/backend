# Application
NODE_ENV=development
PORT=3003
SERVICE_NAME=invoice-processing-service

# CORS
CORS_ORIGIN=*

# MongoDB
MONGODB_URI=mongodb://localhost:27017/invoice-processing

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=invoice-processing-service
KAFKA_CONSUMER_GROUP=invoice-processing-group

# Topics
KAFKA_TOPIC_INVOICE_RECEIVED=invoice.received
KAFKA_TOPIC_INVOICE_VALIDATED=invoice.validated
KAFKA_TOPIC_INVOICE_PROCESSED=invoice.processed
KAFKA_TOPIC_INVOICE_APPROVED=invoice.approved
KAFKA_TOPIC_INVOICE_FAILED=invoice.failed

# OCR Configuration
OCR_ENGINE=tesseract
OCR_TESSERACT_PATH=/usr/bin/tesseract

# Google Vision API
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,png,jpg,jpeg,tiff

# Validation Rules
VALIDATION_DUPLICATE_THRESHOLD_DAYS=30
VALIDATION_TAX_TOLERANCE_PERCENT=0.5
VALIDATION_AMOUNT_MIN=0.01
VALIDATION_AMOUNT_MAX=1000000

# Processing
PROCESSING_TIMEOUT_MS=300000
ASYNC_PROCESSING_ENABLED=true
