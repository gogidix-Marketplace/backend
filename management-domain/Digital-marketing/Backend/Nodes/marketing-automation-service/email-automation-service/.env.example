# Server Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/email_automation

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# SendGrid Configuration
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@gogidix.com
SENDGRID_FROM_NAME=Gogidix

# AWS SES Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS SES_FROM_EMAIL=noreply@gogidix.com
AWS SES_FROM_NAME=Gogidix

# Email Provider Selection
# Options: sendgrid, ses, both
EMAIL_PROVIDER=sendgrid
ENABLE_PROVIDER_FALLBACK=true

# Queue Configuration
EMAIL_QUEUE_CONCURRENCY=5
EMAIL_QUEUE_MAX_ATTEMPTS=3
EMAIL_QUEUE_BACKOFF_TYPE=exponential
EMAIL_QUEUE_BACKOFF_DELAY=2000

# Rate Limiting
SENDGRID_RATE_LIMIT=100
SES_RATE_LIMIT=14
RATE_LIMIT_WINDOW=60000

# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_TIMEOUT=5000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/email-automation.log

# Template Configuration
TEMPLATE_DIR=templates
TEMPLATE_CACHE_ENABLED=true

# Bounce Handling
BOUNCE_WEBHOOK_PATH=/webhook/bounce
COMPLAINT_WEBHOOK_PATH=/webhook/complaint

# API Keys
API_KEY_HEADER=X-API-Key
API_KEYS=api_key_1,api_key_2
