# Server Configuration
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/auto-scaling-service
MONGODB_DB_NAME=auto_scaling_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_AUTO_SCALING_GROUP_NAME=
AWS_EC2_INSTANCE_TYPE=t3.medium

# Azure Configuration
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP_NAME=
AZURE_VM_SCALE_SET_NAME=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Service Configuration
METRICS_COLLECTION_INTERVAL=60000
SCALING_EVALUATION_INTERVAL=120000
SCALING_COOLDOWN_PERIOD=300000
METRICS_RETENTION_DAYS=30

# Notification Configuration
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_SMTP_HOST=
NOTIFICATION_EMAIL_SMTP_PORT=587
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
