# Server Configuration
NODE_ENV=development
PORT=3003
HOST=0.0.0.0

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/lead_scoring

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=2

# Lead Generation Service Integration
LEAD_GENERATION_SERVICE_URL=http://localhost:3004
LEAD_GENERATION_API_KEY=your_lead_generation_api_key

# Scoring Configuration
DEFAULT_LEAD_SCORE=0
MAX_LEAD_SCORE=100
SCORE_DECAY_ENABLED=true
SCORE_DECAY_DAYS=30
SCORE_DECAY_RATE=0.1

# Cache Configuration
SCORE_CACHE_TTL=3600
RULE_CACHE_TTL=300

# Rate Limiting
API_RATE_LIMIT=1000
RATE_LIMIT_WINDOW=60000

# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_TIMEOUT=5000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/lead-scoring.log

# API Keys
API_KEY_HEADER=X-API-Key
API_KEYS=api_key_1,api_key_2

# Segment Configuration
ENABLE_AUTO_SEGMENTATION=true
SEGMENT_RECALCULATION_INTERVAL=3600000
