<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.gogidix.shared</groupId>
    <artifactId>shared-libraries-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Gogidix Shared Libraries Parent</name>
    <description>Parent POM for all Gogidix Social E-commerce Ecosystem shared libraries</description>
    <url>https://github.com/gogidix-technology/gogidix-shared-libraries</url>

    <organization>
        <name>Gogidix Technology</name>
        <url>https://gogidix.com</url>
    </organization>

    <modules>
        <module>shared-libraries-bom</module>
        <module>core-libraries/shared-exceptions</module>
        <module>core-libraries/shared-model</module>
        <module>core-libraries/shared-validation</module>
        <module>core-libraries/shared-service-discovery</module>
        <module>security-libraries/shared-audit</module>
        <module>security-libraries/shared-security</module>
        <module>communication-libraries/shared-messaging</module>
        <module>testing-libraries/shared-testing</module>
        <module>utility-libraries/shared-utilities</module>
        <module>shared-multitenancy</module>
        <module>ai-libraries/shared-ai</module>
    </modules>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <gogidix.shared.version>1.0.0</gogidix.shared.version>

        <!-- Version Management -->
        <spring.boot.version>3.1.5</spring.boot.version>
        <spring.cloud.version>2022.0.4</spring.cloud.version>
        <junit.version>5.10.0</junit.version>
        <mockito.version>5.5.0</mockito.version>
        <testcontainers.version>1.19.1</testcontainers.version>
        <jackson.version>2.15.2</jackson.version>
        <slf4j.version>2.0.9</slf4j.version>
        <logback.version>1.4.11</logback.version>
        <jakarta.validation.version>3.0.2</jakarta.validation.version>
        <hibernate.validator.version>8.0.1.Final</hibernate.validator.version>
        <jjwt.version>0.11.5</jjwt.version>
        <guava.version>32.1.2-jre</guava.version>

        <!-- Library Versions -->
        <lombok.version>1.18.30</lombok.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>

        <!-- Financial-Grade Testing: Coverage Thresholds -->
        <jacoco.version>0.8.10</jacoco.version>
        <pitest.version>1.15.2</pitest.version>
        <pitest.junit5.version>1.2.1</pitest.junit5.version>
        <fg.coverage.minimum>0.85</fg.coverage.minimum>
        <fg.mutation.minimum>60</fg.mutation.minimum>

        <!-- Memory Configuration for CI/Standard Environments -->
        <surefire.heap.min>128m</surefire.heap.min>
        <surefire.heap.max>512m</surefire.heap.max>
        <pitest.heap.min>128m</pitest.heap.min>
        <pitest.heap.max>512m</pitest.heap.max>

        <!-- Test Parallelism -->
        <surefire.parallel.tests>1</surefire.parallel.tests>
        <surefire.parallel.methods>1</surefire.parallel.methods>

        <!-- Test timeout for integration tests -->
        <surefire.timeout>180</surefire.timeout>

        <!-- JVM Arguments -->
        <surefire.jvm.args>-Xms${surefire.heap.min} -Xmx${surefire.heap.max} -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=64m -XX:CompressedClassSpaceSize=64m -Xss256k -Djava.awt.headless=true</surefire.jvm.args>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud BOM -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring.cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Lombok for all modules -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring.boot.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <source>${maven.compiler.source}</source>
                        <target>${maven.compiler.target}</target>
                        <!-- FIX: Suppress deprecation warnings in test compilation because some tests
                             intentionally use deprecated APIs (EmailValidator, PhoneValidator) for backward
                             compatibility. These tests verify the deprecated API still works during the
                             transition period to new hexagonal architecture implementations.
                             Note: testCompilerArgument (singular) is correct for maven-compiler-plugin 3.x -->
                        <testCompilerArgument>-Xlint:-deprecation</testCompilerArgument>
                    <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.0.0</version>
                    <configuration>
                        <argLine>${surefire.jvm.args} @{argLine} -Dsurefire.timeout=${surefire.timeout}</argLine>
                        <parallel>methods</parallel>
                        <threadCount>${surefire.parallel.methods}</threadCount>
                        <perCoreThreadCount>false</perCoreThreadCount>
                        <useSystemClassLoader>false</useSystemClassLoader>
                        <includes>
                            <include>**/*Test.java</include>
                            <include>**/*Tests.java</include>
                        </includes>
                        <forkCount>1</forkCount>
                        <reuseForks>false</reuseForks>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>check</id>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <rules>
                            <rule>
                                <element>BUNDLE</element>
                                <limits>
                                    <limit>
                                        <counter>LINE</counter>
                                        <value>COVEREDRATIO</value>
                                        <minimum>0.80</minimum>
                                    </limit>
                                </limits>
                            </rule>
                        </rules>
                        <haltOnFailure>true</haltOnFailure>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages - CargoNexus Platform</name>
            <url>https://maven.pkg.github.com/cargoNexus-africa/CargoNexus-Shared-Infrastructure</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <name>GitHub Packages - CargoNexus Platform Snapshots</name>
            <url>https://maven.pkg.github.com/cargoNexus-africa/CargoNexus-Shared-Infrastructure</url>
        </snapshotRepository>
    </distributionManagement>

    <profiles>
        <!-- CI Profile: Coverage-focused -->
        <profile>
            <id>ci</id>
            <properties>
                <pitest.skip>true</pitest.skip>
            </properties>
        </profile>

        <!-- Local Development Profile -->
        <profile>
            <id>local</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <pitest.skip>true</pitest.skip>
            </properties>
        </profile>

        <!-- Certification Profile: Full testing including mutation -->
        <profile>
            <id>certification</id>
            <properties>
                <pitest.skip>false</pitest.skip>
            </properties>
        </profile>
    </profiles>

</project>
