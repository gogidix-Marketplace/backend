        LocalDateTime now = LocalDateTime.now();
        return new User(
            getId(), getVersion(), getCreatedAt(), getCreatedBy(),
            now, updatedBy, isDeleted(), getDeletedAt(), getDeletedBy(),
            this.username, this.email, firstName, lastName, this.displayName,
            phoneNumber, this.alternateEmail, this.profileImageUrl, this.personalWebsite,
            this.dateOfBirth, this.gender, this.nationality, this.languageCode,
            this.timezone, this.locale,
            this.userStatus, this.userType, this.roles, this.permissions,
            this.tier, this.organizationId, this.departmentId,
            this.emailVerified, this.phoneVerified, this.twoFactorEnabled, this.accountLocked,
            this.lastLoginAt, this.failedLoginAttempts, this.lockedUntil, this.lockReason,
            this.lastPasswordChangeAt, this.passwordExpiryDays,
            this.passwordResetToken, this.passwordResetExpiresAt,
            this.emailVerificationToken, this.emailVerificationExpiresAt,
            this.phoneVerificationToken, this.phoneVerificationExpiresAt,
            this.mfaSecret, this.mfaBackupCodes,
            this.termsAcceptedAt, this.termsVersion, this.privacyAcceptedAt,
            this.privacyVersion, this.marketingOptIn, this.dataProcessingConsent,
            this.consentUpdatedAt,
            this.loginCount, this.firstLoginAt, this.lastKnownIpAddress,
            this.lastKnownUserAgent, this.lastKnownLocation,
            this.preferences, this.metadata,
            this.subscriptionStartDate, this.subscriptionEndDate,
            this.isPremiumUser, this.lifetimeValue, this.supportTicketCount, this.satisfactionScore
        );
    }
    
    /**
     * Sets password reset token.
     */
    public User setPasswordResetToken(String token, LocalDateTime expiresAt) {
        return this.withPasswordResetToken(token)
                  .withPasswordResetExpiresAt(expiresAt);
    }
    
    /**
     * Clears password reset token.
     */
    public User clearPasswordResetToken() {
        return this.withPasswordResetToken(null)
                  .withPasswordResetExpiresAt(null);
    }
    
    /**
     * Checks if password reset token is valid.
     */
    public boolean isPasswordResetTokenValid() {
        return passwordResetToken != null && 
               passwordResetExpiresAt != null && 
               passwordResetExpiresAt.isAfter(LocalDateTime.now());
    }
    
    /**
     * Enables two-factor authentication.
     */
    public User enableTwoFactor() {
        return this.withTwoFactorEnabled(true);
    }
    
    /**
     * Disables two-factor authentication.
     */
    public User disableTwoFactor() {
        return this.withTwoFactorEnabled(false);
    }
    
    /**
     * Updates marketing preferences.
     */
    public User updateMarketingOptIn(boolean optIn, String updatedBy) {
        LocalDateTime now = LocalDateTime.now();
        return new User(
            getId(), getVersion(), getCreatedAt(), getCreatedBy(),
            now, updatedBy, isDeleted(), getDeletedAt(), getDeletedBy(),
            this.username, this.email, this.firstName, this.lastName, this.displayName,
            this.phoneNumber, this.alternateEmail, this.profileImageUrl, this.personalWebsite,
            this.dateOfBirth, this.gender, this.nationality, this.languageCode,
            this.timezone, this.locale,
            this.userStatus, this.userType, this.roles, this.permissions,
            this.tier, this.organizationId, this.departmentId,
            this.emailVerified, this.phoneVerified, this.twoFactorEnabled, this.accountLocked,
            this.lastLoginAt, this.failedLoginAttempts, this.lockedUntil, this.lockReason,
            this.lastPasswordChangeAt, this.passwordExpiryDays,
            this.passwordResetToken, this.passwordResetExpiresAt,
            this.emailVerificationToken, this.emailVerificationExpiresAt,
            this.phoneVerificationToken, this.phoneVerificationExpiresAt,
            this.mfaSecret, this.mfaBackupCodes,
            this.termsAcceptedAt, this.termsVersion, this.privacyAcceptedAt,
            this.privacyVersion, optIn, this.dataProcessingConsent,
            this.consentUpdatedAt,
            this.loginCount, this.firstLoginAt, this.lastKnownIpAddress,
            this.lastKnownUserAgent, this.lastKnownLocation,
            this.preferences, this.metadata,
            this.subscriptionStartDate, this.subscriptionEndDate,
            this.isPremiumUser, this.lifetimeValue, this.supportTicketCount, this.satisfactionScore
        );
    }
    
    /**
     * Suspends the user account.
     */
    public User suspend(String suspendedBy) {
        return this.changeStatus(UserStatus.SUSPENDED, suspendedBy);
    }
    
    /**
     * Activates the user account.
     */
    public User activate(String activatedBy) {
        return this.changeStatus(UserStatus.ACTIVE, activatedBy);
    }
    
    /**
     * Deactivates the user account.
     */
    public User deactivate(String deactivatedBy) {
        return this.changeStatus(UserStatus.INACTIVE, deactivatedBy);
    }
    
    @Override
    public boolean isValid() {
        return username != null && !username.trim().isEmpty() &&
               email != null && !email.trim().isEmpty() &&
               getStatus() != null &&
               userType != null && !userType.trim().isEmpty();
    }
    
    @Override
    public boolean isComplete() {
        return isValid() &&
               firstName != null && !firstName.trim().isEmpty() &&
               lastName != null && !lastName.trim().isEmpty() &&
               emailVerified;
    }
    
    @Override
    public String getEntityType() {
        return "USER";
    }
    
    /**
     * Determines if this user can be deleted.
     */
    @Override
    public boolean canBeDeleted() {
        return super.canBeDeleted() && 
               (userStatus == UserStatus.INACTIVE || userStatus == UserStatus.SUSPENDED);
    }
    
    /**
     * Gets user display name.
     */
    public String getDisplayName() {
        String fullName = getFullName();
        return fullName.equals(username) ? username : fullName;
    }
    
    /**
     * Checks if user profile is complete.
     */
    public boolean isProfileComplete() {
        return firstName != null && !firstName.trim().isEmpty() &&
               lastName != null && !lastName.trim().isEmpty() &&
               email != null && !email.trim().isEmpty() &&
               emailVerified;
    }
    
    /**
     * Checks if account needs attention (locked, suspended, etc.).
     */
    public boolean needsAttention() {
        return isAccountLocked() || 
               userStatus == UserStatus.SUSPENDED || 
               userStatus == UserStatus.PENDING_VERIFICATION ||
               failedLoginAttempts >= 3;
    }
    
    /**
     * Gets account security score (0-100).
     */
    public int getSecurityScore() {
        int score = 0;
        
        if (emailVerified) score += 20;
        if (phoneVerified) score += 15;
        if (twoFactorEnabled) score += 25;
        if (!isAccountLocked()) score += 10;
        if (failedLoginAttempts == 0) score += 10;
        if (isProfileComplete()) score += 20;
        
        return score;
    }
    
    /**
     * Checks if user is eligible for specific features.
     */
    public boolean isEligibleForFeature(String featureName) {
        return switch (featureName.toLowerCase()) {
            case "premium" -> hasRole(UserRole.PREMIUM_USER) || hasRole(UserRole.ADMIN);
            case "admin" -> hasRole(UserRole.ADMIN) || hasRole(UserRole.SUPER_ADMIN);
            case "vendor" -> hasRole(UserRole.VENDOR) || hasRole(UserRole.ADMIN);
            case "beta" -> hasRole(UserRole.BETA_TESTER) || hasRole(UserRole.ADMIN);
            default -> isAccountActive();
        };
    }
    
    /**
     * Gets user risk level based on account status and activity.
     */
    public UserRiskLevel getRiskLevel() {
        if (userStatus == UserStatus.SUSPENDED || isAccountLocked()) {
            return UserRiskLevel.HIGH;
        }
        if (failedLoginAttempts >= 3 || !emailVerified) {
            return UserRiskLevel.MEDIUM;
        }
        if (!twoFactorEnabled || getSecurityScore() < 70) {
            return UserRiskLevel.LOW;
        }
        return UserRiskLevel.MINIMAL;
    }
    
    /**
     * User risk levels for security assessment.
     */
    public enum UserRiskLevel {
        MINIMAL, LOW, MEDIUM, HIGH
    }
    
    // ========================================
    // Standard Getter Methods
    // ========================================
    
    public String getUsername() { return username; }
    public String getEmail() { return email; }
