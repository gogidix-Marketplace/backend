<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!-- 
    OWASP Dependency Check Suppressions for Shared Utilities Library
    This file contains suppressions for known false positives and acceptable risks
    -->
    
    <!-- Spring Boot Test Dependencies - Dev/Test scope only -->
    <suppress>
        <notes>Spring Boot test dependencies are only used in test scope</notes>
        <cve>CVE-2023-20883</cve>
        <gav regex="true">.*spring-boot-starter-test.*</gav>
    </suppress>
    
    <!-- H2 Database - Test scope only -->
    <suppress>
        <notes>H2 database is only used for testing, not in production</notes>
        <cve>CVE-2022-45868</cve>
        <gav regex="true">.*h2.*</gav>
    </suppress>
    
    <!-- Apache POI - File processing utility -->
    <suppress>
        <notes>Apache POI CVEs related to XML parsing - mitigated by input validation</notes>
        <cve>CVE-2019-12415</cve>
        <gav regex="true">.*poi.*</gav>
    </suppress>
    
    <!-- Jackson - JSON processing -->
    <suppress>
        <notes>Jackson CVEs related to deserialization - mitigated by configuration</notes>
        <cve>CVE-2020-36518</cve>
        <gav regex="true">.*jackson.*</gav>
    </suppress>
    
    <!-- TestContainers - Test scope only -->
    <suppress>
        <notes>TestContainers is only used for integration testing</notes>
        <gav regex="true">.*testcontainers.*</gav>
    </suppress>
    
    <!-- Development and Build Tools -->
    <suppress>
        <notes>Development tools not included in production artifacts</notes>
        <gav regex="true">.*maven.*</gav>
        <gav regex="true">.*lombok.*</gav>
        <gav regex="true">.*mapstruct.*</gav>
    </suppress>
</suppressions>