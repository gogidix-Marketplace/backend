package com.gogidix.infrastructure.centralizeddashboard.apigateway.domain.port.in;

import com.gogidix.infrastructure.centralizeddashboard.apigateway.domain.model.*;
import java.util.List;
import java.util.Optional;

public interface RouteManagementUseCase {
    
    RouteConfiguration createRoute(CreateRouteCommand command);
    
    RouteConfiguration updateRoute(UpdateRouteCommand command);
    
    RouteConfiguration activateRoute(RouteId routeId);
    
    RouteConfiguration deactivateRoute(RouteId routeId);
    
    void deleteRoute(RouteId routeId);
    
    Optional<RouteConfiguration> findRoute(RouteId routeId);
    
    List<RouteConfiguration> findRoutesByService(String serviceName);
    
    List<RouteConfiguration> findActiveRoutes();
    
    List<RouteConfiguration> findAllRoutes();
    
    boolean validateRouteConfiguration(RouteConfiguration route);
    
    record CreateRouteCommand(
        String serviceName,
        String path,
        String uri,
        List<String> predicates,
        List<FilterRule> filters,
        Integer order,
        RateLimitConfig rateLimitConfig,
        CircuitBreakerConfig circuitBreakerConfig,
        AuthenticationConfig authenticationConfig
    ) {}
    
    record UpdateRouteCommand(
        RouteId routeId,
        String serviceName,
        String path,
        String uri,
        List<String> predicates,
        List<FilterRule> filters,
        Integer order,
        RateLimitConfig rateLimitConfig,
        CircuitBreakerConfig circuitBreakerConfig,
        AuthenticationConfig authenticationConfig
    ) {}
}