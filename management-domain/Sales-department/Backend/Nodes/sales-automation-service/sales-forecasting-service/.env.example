# Application
NODE_ENV=development
PORT=3004
SERVICE_NAME=sales-forecasting-service

# Database
MONGODB_URI=mongodb://localhost:27017/sales-forecasting
MONGODB_DB_NAME=sales-forecasting

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=sales-forecasting-service
KAFKA_CONSUMER_GROUP=sales-forecasting-group
KAFKA_FORECAST_TOPIC=sales.forecast.events
KAFKA_PIPELINE_UPDATE_TOPIC=sales.pipeline.updated
KAFKA_OPPORTUNITY_TOPIC=sales.opportunity.events

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_TTL=3600

# JWT
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRATION=86400

# API
API_PREFIX=api/v1
SWAGGER_ENABLED=true

# Forecasting
FORECAST_MODEL_DEFAULT=weighted_pipeline
FORECAST_HORIZON_MONTHS=12
ROLLING_FORECAST_ENABLED=true
ROLLING_FORECAST_FREQUENCY=0 0 * * *

# Multi-tenancy
TENANT_HEADER=X-Tenant-ID
DEFAULT_TENANT=default
