# ML Model Training Service Configuration
# Copy this file to .env and update values

# Service Configuration
ML_TRAINING_HOST=0.0.0.0
ML_TRAINING_PORT=8001
ML_TRAINING_DEBUG=false

# Storage
MODEL_STORAGE_PATH=/app/models
DATA_STORAGE_PATH=/app/data
LOG_STORAGE_PATH=/app/logs

# Database
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=ml_training

# Cache
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# Message Queue
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRAINING=ml.training.jobs

# Training Configuration
MAX_CONCURRENT_JOBS=5
JOB_TIMEOUT_SECONDS=3600
MAX_MODEL_SIZE_MB=500

# Feature Store
FEATURE_STORE_URL=http://localhost:8002

# Observability
METRICS_ENABLED=true
TRACING_ENABLED=false
LOG_LEVEL=INFO
