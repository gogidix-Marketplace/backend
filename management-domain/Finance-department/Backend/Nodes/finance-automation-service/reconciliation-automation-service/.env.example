# Application
NODE_ENV=development
PORT=3003
SERVICE_NAME=reconciliation-automation-service

# API Documentation
SWAGGER_ENABLED=true

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/reconciliation-automation

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=reconciliation-automation-service
KAFKA_GROUP_ID=reconciliation-automation-group
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=
KAFKA_USERNAME=
KAFKA_PASSWORD=

# Bank API
BANK_API_URL=http://localhost:8080
BANK_API_KEY=

# Internal API
INTERNAL_API_URL=http://localhost:8081
INTERNAL_API_KEY=

# Logging
LOG_LEVEL=debug
LOG_FILE_PATH=./logs

# Scheduler
ENABLE_SCHEDULER=true
