# API Configuration
VITE_API_URL=http://localhost:4000
VITE_API_TIMEOUT=30000

# Authentication
VITE_JWT_SECRET=your-secret-key-change-in-production
VITE_TOKEN_REFRESH_INTERVAL=2700000

# Application Configuration
VITE_APP_NAME=Gogidix Corporate Admin
VITE_APP_URL=http://localhost:3001
VITE_PUBLIC_URL=http://localhost:3000

# File Upload Configuration
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webg,application/pdf

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_RICH_TEXT_EDITOR=true
VITE_ENABLE_MEDIA_LIBRARY=true
VITE_ENABLE_SCHEDULING=true

# Environment
VITE_ENV=development

# Sentry (Optional)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Google Analytics (Optional)
VITE_GA_MEASUREMENT_ID=
