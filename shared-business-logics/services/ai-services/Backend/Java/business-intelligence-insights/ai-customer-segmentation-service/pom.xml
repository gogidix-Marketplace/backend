    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Dependency Versions -->
        <spring-cloud.version>2022.0.4</spring-cloud.version>
        <lombok.version>1.18.30</lombok.version>
        <mockito.version>5.5.0</mockito.version>
        <springdoc.version>2.3.0</springdoc.version>
        <testcontainers.version>1.19.3</testcontainers.version>
        <archunit.version>1.2.1</archunit.version>
        <jacoco.version>0.8.11</jacoco.version>

        <!-- Financial-Grade Testing: Coverage Thresholds -->
        <!-- Line coverage minimum for Financial-Grade Blueprint v1.0 -->
        <fg.coverage.minimum>0.85</fg.coverage.minimum>
        <!-- Branch coverage minimum for Financial-Grade Blueprint v1.0 -->
        <fg.branch.minimum>0.75</fg.branch.minimum>

        <!-- Memory Configuration for CI/Standard Environments -->
        <surefire.heap.min>128m</surefire.heap.min>
        <surefire.heap.max>512m</surefire.heap.max>

        <!-- Test timeout for integration tests -->
        <surefire.timeout>180</surefire.timeout>

        <!-- JVM Arguments - Optimized for memory-constrained environments -->
        <surefire.jvm.args>-Xms${surefire.heap.min} -Xmx${surefire.heap.max} -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=64m -XX:CompressedClassSpaceSize=64m -Xss256k -Djava.awt.headless=true</surefire.jvm.args>
    </properties>

