# Gogidix Production Configuration Template
# Copy this file to src/main/resources/application-prod.yml
# Update values marked with CHANGE_ME as needed

server:
  port: ${SERVER_PORT:8080}
  shutdown: graceful
  tomcat:
    threads:
      max: ${TOMCAT_MAX_THREADS:200}
      min-spare: ${TOMCAT_MIN_SPARE_THREADS:10}
    connection-timeout: ${CONNECTION_TIMEOUT:20000}
    keep-alive-timeout: ${KEEP_ALIVE_TIMEOUT:60000}
  compression:
    enabled: true
    mime-types: text/html,text/xml,text/plain,text/css,application/javascript,application/json

spring:
  application:
    name: ${SPRING_APPLICATION_NAME:CHANGE_ME_SERVICE_NAME}
  profiles:
    active: prod

  # Database Configuration - PostgreSQL
  datasource:
    url: ${DATABASE_URL:jdbc:postgresql://${DATABASE_HOST:postgres.internal}:5432/${DATABASE_NAME:CHANGE_ME_DATABASE}?sslmode=require}
    username: ${DATABASE_USERNAME:CHANGE_ME}
    password: ${DATABASE_PASSWORD:CHANGE_ME}
    hikari:
      maximum-pool-size: ${HIKARI_MAX_POOL_SIZE:20}
      minimum-idle: ${HIKARI_MIN_IDLE:5}
      connection-timeout: ${CONNECTION_TIMEOUT:30000}
      idle-timeout: ${IDLE_TIMEOUT:600000}
      max-lifetime: ${MAX_LIFETIME:1800000}
      leak-detection-threshold: ${LEAK_DETECTION_THRESHOLD:60000}

  # Database Configuration - MongoDB (if applicable)
  data:
    mongodb:
      uri: ${MONGODB_URI:mongodb://${MONGODB_USERNAME:}${MONGODB_PASSWORD:}@${MONGODB_HOST:mongodb.internal}:27017/${MONGODB_DATABASE:CHANGE_ME}?authSource=admin}
      auto-index-creation: true

  # JPA Configuration
  jpa:
    hibernate:
      ddl-auto: none
    show-sql: false
    properties:
      hibernate:
        dialect: org.hibernate.dialect.PostgreSQLDialect
        format_sql: false
        jdbc:
          batch_size: 25
          order_inserts: true
          order_updates: true
        cache:
          use_second_level_cache: true
          use_query_cache: true

  # Redis Configuration
  redis:
    host: ${REDIS_HOST:redis.internal}
    port: ${REDIS_PORT:6379}
    password: ${REDIS_PASSWORD:}
    database: ${REDIS_DATABASE:0}
    timeout: ${REDIS_TIMEOUT:2000}
    lettuce:
      pool:
        max-active: ${REDIS_MAX_ACTIVE:20}
        max-idle: ${REDIS_MAX_IDLE:10}
        min-idle: ${REDIS_MIN_IDLE:0}
        max-wait: ${REDIS_MAX_WAIT:-1ms}

  # Kafka Configuration
  kafka:
    bootstrap-servers: ${KAFKA_BOOTSTRAP_SERVERS:kafka.internal:9092}
    client:
      id: ${spring.application.name}-${server.port}
    consumer:
      group-id: ${KAFKA_CONSUMER_GROUP_ID:${spring.application.name}-consumer}
      auto-offset-reset: ${KAFKA_AUTO_OFFSET_RESET:latest}
      enable-auto-commit: false
      key-deserializer: org.apache.kafka.common.serialization.StringDeserializer
      value-deserializer: org.springframework.kafka.support.serializer.JsonDeserializer
      properties:
        spring.json.trusted.packages: "*"
        max.poll.records: ${KAFKA_MAX_POLL_RECORDS:100}
        session.timeout.ms: ${KAFKA_SESSION_TIMEOUT:30000}
        heartbeat.interval.ms: ${KAFKA_HEARTBEAT_INTERVAL:10000}
    producer:
      key-serializer: org.apache.kafka.common.serialization.StringSerializer
      value-serializer: org.springframework.kafka.support.serializer.JsonSerializer
      acks: ${KAFKA_PRODUCER_ACKS:1}
      retries: ${KAFKA_PRODUCER_RETRIES:3}
      properties:
        request.timeout.ms: ${KAFKA_REQUEST_TIMEOUT:5000}
        delivery.timeout.ms: ${KAFKA_DELIVERY_TIMEOUT:10000}
    listener:
      ack-mode: manual
      concurrency: ${KAFKA_LISTENER_CONCURRENCY:3}

  # Cache Configuration
  cache:
    type: redis
    redis:
      time-to-live: ${CACHE_TTL:300s}
      cache-null-values: false
      key-prefix: "${spring.application.name}:"

  # Security Configuration
  security:
    oauth2:
      resourceserver:
        jwt:
          issuer-uri: ${OAUTH2_ISSUER_URI:https://auth.gogidix.com/auth/realms/gogidix}
          jwk-set-uri: ${OAUTH2_JWK_SET_URI:https://auth.gogidix.com/auth/realms/gogidix/protocol/openid-connect/certs}

  # Cloud Configuration
  cloud:
    loadbalancer:
      ribbon:
        enabled: false
      cache:
        enabled: true
        ttl: 30s
        capacity: 256

# Eureka Client Configuration
eureka:
  instance:
    prefer-ip-address: true
    lease-renewal-interval-in-seconds: 15
    lease-expiration-duration-in-seconds: 45
    metadata-map:
      zone: primary
      version: ${spring.application.version:1.0.0}
      metrics-path: /actuator/prometheus
    hostname: ${EUREKA_HOSTNAME:${spring.application.name}}
  client:
    register-with-eureka: true
    fetch-registry: true
    service-url:
      defaultZone: ${EUREKA_SERVER_URL:http://eureka-server:8761/eureka/}
    registry-fetch-interval-seconds: 15

# Management / Actuator Configuration
management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics,prometheus
        base-path: /actuator
  endpoint:
    health:
      show-details: when-authorized
      probes:
        enabled: true
      liveness-state:
        enabled: true
      readiness-state:
        enabled: true
    prometheus:
      enabled: true
    metrics:
      enabled: true
  metrics:
    export:
      prometheus:
        enabled: true
    distribution:
      percentiles-histogram:
        http.server.requests: true
      percentiles:
        http.server.requests: 0.5,0.95,0.99
      sla:
        http.server.requests: 100ms,500ms,1s,5s
    tags:
      application: ${spring.application.name}
      environment: prod
    enable:
      jvm: true
      logback: true
      process: true
      system: true
  health:
    redis:
      enabled: true
    db:
      enabled: true
    diskspace:
      enabled: true

# Logging Configuration
logging:
  level:
    root: ${LOG_LEVEL_ROOT:INFO}
    com.gogidix: ${LOG_LEVEL_APP:INFO}
    org.springframework: ${LOG_LEVEL_SPRING:WARN}
    org.hibernate.SQL: ${LOG_LEVEL_SQL:WARN}
    org.hibernate.type.descriptor.sql.BasicBinder: ${LOG_LEVEL_SQL_BIND:WARN}
  pattern:
    console: "%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId},%X{spanId}] %logger{36} - %msg%n"
    file: "%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId},%X{spanId}] %logger{36} - %msg%n"
  file:
    name: /logs/${spring.application.name}.log
    max-size: 100MB
    max-history: 30
    total-size-cap: 10GB

# Resilience4j Configuration
resilience4j:
  circuitbreaker:
    configs:
      default:
        sliding-window-size: 20
        permitted-number-of-calls-in-half-open-state: 5
        failure-rate-threshold: 50
        wait-duration-in-open-state: 30s
        minimum-number-of-calls: 10
        automatic-transition-from-open-to-half-open-enabled: true
    instances:
      backend:
        base-config: default
  timelimiter:
    configs:
      default:
        timeout-duration: 10s
        cancel-running-future: true
    instances:
      backend:
        base-config: default
  retry:
    configs:
      default:
        max-attempts: 3
        wait-duration: 500ms
        retry-exceptions:
          - java.io.IOException
          - java.util.concurrent.TimeoutException
        ignore-exceptions:
          - java.lang.IllegalArgumentException
    instances:
      backend:
        base-config: default

# OpenAPI/Swagger Configuration (Optional - disable in prod if preferred)
springdoc:
  api-docs:
    enabled: ${SWAGGER_ENABLED:false}
    path: /api-docs
  swagger-ui:
    enabled: ${SWAGGER_ENABLED:false}
    path: /swagger-ui.html

# Service-Specific Configuration
# Add your service-specific values below
service:
  name: ${spring.application.name}
  version: ${SERVICE_VERSION:1.0.0}
  environment: prod

  # Feature flags
  features:
    cache-enabled: ${FEATURE_CACHE_ENABLED:true}
    async-enabled: ${FEATURE_ASYNC_ENABLED:true}
    tracing-enabled: ${FEATURE_TRACING_ENABLED:true}

  # Business logic configuration
  config:
    # Add service-specific configuration here
    batch-size: ${SERVICE_BATCH_SIZE:100}
    timeout: ${SERVICE_TIMEOUT:30000}
