<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.gogidix.shared-business</groupId>
    <artifactId>shared-ecommerce-core</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>shared-ecommerce-core</name>
    <description>E-Commerce Core for Gogidix Platform</description>

    <properties>
        <java.version>17</java.version>
        <spring-boot.version>3.1.5</spring-boot.version>
        <lombok.version>1.18.30</lombok.version>
        <mockito.version>5.8.0</mockito.version>
        <junit.version>5.10.0</junit.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.encoding>UTF-8</maven.compiler.encoding>
    </properties>

    <modules>
        <!-- Catalog -->
        <module>Catalog/category-service</module>
        <module>Catalog/inventory-sync-service</module>
        <module>Catalog/pricing-service</module>
        <module>Catalog/bundle-service</module>
        <module>Catalog/catalog-service</module>
        <module>Catalog/variant-service</module>
        <!-- Fulfillment -->
        <module>Fulfillment/air-freight-integration-service</module>
        <module>Fulfillment/courier-integration-service</module>
        <module>Fulfillment/fulfillment-orchestrator-service</module>
        <module>Fulfillment/haulage-integration-service</module>
        <module>Fulfillment/ocean-shipping-integration-service</module>
        <module>Fulfillment/warehouse-integration-service</module>
        <module>Fulfillment/delivery-service</module>
        <module>Fulfillment/fulfillment-service</module>
        <module>Fulfillment/order-tracking-service</module>
        <module>Fulfillment/realtime-tracking-service</module>
        <module>Fulfillment/shipping-service</module>
        <!-- Influencer -->
        <module>Influencer/affiliate-service</module>
        <module>Influencer/commission-service</module>
        <module>Influencer/influencer-dashboard-service</module>
        <module>Influencer/social-integration-service</module>
        <module>Influencer/influencer-service</module>
        <!-- Marketplace -->
        <module>Marketplace/marketplace-search-service</module>
        <module>Marketplace/commission-service</module>
        <module>Marketplace/marketplace-service</module>
        <module>Marketplace/sme-marketplace-service</module>
        <module>Marketplace/wholesale-marketplace-service</module>
        <!-- Order -->
        <module>Order/cart-service</module>
        <module>Order/checkout-service</module>
        <module>Order/payment-service</module>
        <module>Order/exchange-service</module>
        <module>Order/order-service</module>
        <module>Order/returns-service</module>
        <!-- Procurement -->
        <module>Procurement/approval-workflow-service</module>
        <module>Procurement/budget-service</module>
        <module>Procurement/reconciliation-service</module>
        <module>Procurement/requisition-service</module>
        <module>Procurement/branch-dashboard-service</module>
        <module>Procurement/hq-dashboard-service</module>
        <!-- PublicAPI -->
        <module>PublicAPI/public-cart-service</module>
        <module>PublicAPI/public-catalog-service</module>
        <module>PublicAPI/public-search-service</module>
        <!-- Tenant -->
        <module>Tenant/tenant-config-service</module>
        <module>Tenant/tenant-hierarchy-service</module>
        <!-- Tracking -->
        <module>Tracking/order-tracking-service</module>
        <module>Tracking/realtime-tracking-service</module>
        <!-- Vendor -->
        <module>Vendor/dropship-service</module>
        <module>Vendor/onboarding-service</module>
        <module>Vendor/vendor-analytics-service</module>
        <module>Vendor/vendor-dashboard-service</module>
        <module>Vendor/vendor-service</module>
        <!-- Wholesaler -->
        <module>Wholesaler/bulk-pricing-service</module>
        <module>Wholesaler/contract-management-service</module>
        <module>Wholesaler/wholesaler-dashboard-service</module>
        <module>Wholesaler/wholesaler-service</module>
        <!-- Analytics -->
        <module>Analytics/analytics-service</module>
        <!-- Cart -->
        <module>Cart/cart-service</module>
        <!-- Communication -->
        <module>Communication/communication-service</module>
        <!-- Customer -->
        <module>Customer/customer-service</module>
        <!-- Discount -->
        <module>Discount/discount-service</module>
        <!-- Integration -->
        <module>Integration/air-freight-integration-service</module>
        <module>Integration/ocean-shipping-integration-service</module>
        <module>Integration/warehouse-integration-service</module>
        <!-- Inventory -->
        <module>Inventory/inventory-service</module>
        <module>Inventory/inventory-sync-service</module>
        <!-- Loyalty -->
        <module>Loyalty/gift-card-service</module>
        <module>Loyalty/loyalty-service</module>
        <module>Loyalty/reward-service</module>
        <module>Loyalty/store-credit-service</module>
        <!-- Notification -->
        <module>Notification/email-service</module>
        <module>Notification/notification-service</module>
        <module>Notification/push-notification-service</module>
        <module>Notification/sms-service</module>
        <!-- Payment -->
        <module>Payment/payment-gateway-service</module>
        <module>Payment/payment-method-service</module>
        <module>Payment/payment-service</module>
        <!-- Pricing -->
        <module>Pricing/pricing-service</module>
        <!-- Promotion -->
        <module>Promotion/coupon-service</module>
        <module>Promotion/promotion-service</module>
        <!-- Search -->
        <module>Search/search-service</module>
        <!-- Wishlist -->
        <module>Wishlist/wishlist-service</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>2022.0.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers</artifactId>
                <version>1.19.0</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>1.19.0</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>mongodb</artifactId>
                <version>1.19.0</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <source>17</source>
                        <target>17</target>
                        <release>17</release>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.11</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>check</id>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>INSTRUCTION</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>0.60</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                    <configuration>
                        <argLine>${argLine} -Xmx256m</argLine>
                        <useSystemClassLoader>false</useSystemClassLoader>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <skip>false</skip>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.60</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>${argLine} -Xmx256m</argLine>
                    <useSystemClassLoader>false</useSystemClassLoader>
                </configuration>
            </plugin>
                <!-- Quality Audit Plugins -->
        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-checkstyle-plugin</artifactId>
            <version>3.3.1</version>
            <dependencies>
                <dependency>
                    <groupId>com.puppycrawl.tools</groupId>
                    <artifactId>checkstyle</artifactId>
                    <version>10.12.5</version>
                </dependency>
            </dependencies>
            <configuration>
                <failsOnError>false</failsOnError>
                <failOnViolation>false</failOnViolation>
                <consoleOutput>true</consoleOutput>
                <encoding>UTF-8</encoding>
                <sourceDirectories>
                    <sourceDirectory></sourceDirectory>
                </sourceDirectories>
                <configLocation>google_checks.xml</configLocation>
                <violationSeverity>warning</violationSeverity>
            </configuration>
        </plugin>
        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-pmd-plugin</artifactId>
            <version>3.21.2</version>
            <configuration>
                <failOnViolation>false</failOnViolation>
                <printFailingErrors>true</printFailingErrors>
                <rulesets>
                    <ruleset>category/java/bestpractices.xml</ruleset>
                    <ruleset>category/java/codestyle.xml</ruleset>
                    <ruleset>category/java/design.xml</ruleset>
                    <ruleset>category/java/errorprone.xml</ruleset>
                    <ruleset>category/java/security.xml</ruleset>
                </rulesets>
                <excludeFromFailureFile></excludeFromFailureFile>
            </configuration>
        </plugin>
        <plugin>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-maven-plugin</artifactId>
            <version>4.8.3.0</version>
            <configuration>
                <failOnError>false</failOnError>
                <threshold>medium</threshold>
                <effort>default</effort>
            </configuration>
        </plugin></plugins>
    </build>
</project>
