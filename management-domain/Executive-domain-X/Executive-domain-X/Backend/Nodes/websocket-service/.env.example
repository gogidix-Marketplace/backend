# Server Configuration
NODE_ENV=development
PORT=4000
HOST=localhost
API_PREFIX=/api/v1

# WebSocket Configuration
WS_PORT=4001
WS_PATH=/socket.io
WS_CORS_ORIGIN=http://localhost:3000,http://localhost:3001
WS_PING_INTERVAL=25000
WS_PING_TIMEOUT=20000
WS_MAX_HTTP_BUFFER_SIZE=1e8

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_CLUSTER_MODE=false
REDIS_CLUSTER_NODES=
REDIS_SENTINEL_MODE=false
REDIS_SENTINEL_NAME=
REDIS_SENTINEL_NODES=
REDIS_USERNAME=

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
DB_NAME=gogidix_executive
MONGODB_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2

# Kafka Configuration
KAFKA_BROKERS=localhost:9092,localhost:9093,localhost:9094
KAFKA_CLIENT_ID=websocket-service
KAFKA_CONSUMER_GROUP_ID=websocket-service-group
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_MAX_RETRIES=3
KAFKA_CONSUMER_SESSION_TIMEOUT=30000
KAFKA_CONSUMER_HEARTBEAT_INTERVAL=3000

# Kafka Topics
KAFKA_TOPICS_EXECUTIVE_UPDATES=executive.updates
KAFKA_TOPICS_KPI_UPDATES=kpi.updates
KAFKA_TOPICS_DASHBOARD_UPDATES=dashboard.updates
KAFKA_TOPICS_NOTIFICATIONS=notifications
KAFKA_TOPICS_PRESENCE=presence.events

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=gogidix-websocket-service
JWT_AUDIENCE=gogidix-executive-domain

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_FAILED_REQUESTS=true
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# Connection Limits
MAX_CONNECTIONS_PER_TENANT=100
MAX_CONNECTIONS_PER_USER=5
MAX_ROOMS_PER_TENANT=50
MAX_USERS_PER_ROOM=100

# Presence Configuration
PRESENCE_TTL=120
PRESENCE_SYNC_INTERVAL=30000
PRESENCE_TYPING_TIMEOUT=5000

# Logging
LOG_LEVEL=info
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization

# Health Check
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# Multi-Tenancy
MULTI_TENANT_ENABLED=true
DEFAULT_TENANT_ID=default

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics
